# --- AssemblyAI ---
# Get at: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# --- Google Docs ---
# Create an OAuth 2.0 Client ID at: https://console.cloud.google.com
# Enable: Google Docs API + Google Drive API
# Run: python setup_oauth.py  (writes the token file below)
GOOGLE_OAUTH_CREDENTIALS=./credentials/google_oauth_token.json

# --- Anthropic (Claude) ---
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Notion ---
# Create integration at: https://www.notion.so/my-integrations
# Share your target database with the integration
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_PODCAST_ID=your_podcast_episodes_database_id
NOTION_TOPIC_HUB_ID=your_topic_hub_database_id
NOTION_SYNTHESIS_PAGE_ID=your_synthesis_parent_page_id
NOTION_PHRASE_LIBRARY_ID=your_speaker_phrase_library_database_id

# --- Optional ---
# Google Drive folder ID where transcript docs will be created
# If not set, docs are created in the account's root Drive
GOOGLE_DRIVE_FOLDER_ID=
