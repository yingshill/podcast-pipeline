# --- AssemblyAI ---
# Get at: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# --- Google Docs ---
# Create a service account at: https://console.cloud.google.com
# Enable: Google Docs API + Google Drive API
# Download the JSON key file and set the path below
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
# If using OAuth2 (personal account) instead:
# GOOGLE_OAUTH_CREDENTIALS=./credentials/google_oauth_credentials.json

# --- Anthropic (Claude) ---
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Notion ---
# Create integration at: https://www.notion.so/my-integrations
# Share your target database with the integration
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_target_database_id_here

# --- Optional ---
# Google Drive folder ID where transcript docs will be created
# If not set, docs are created in the service account's root Drive
GOOGLE_DRIVE_FOLDER_ID=
